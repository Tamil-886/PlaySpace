{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/playspace/index.html"
    },
    {
      "source": "/playspace",
      "destination": "/playspace/index.html"
    },
    {
      "source": "/((?!playspace/).*)",
      "destination": "/playspace/$1"
    }
  ]
}
